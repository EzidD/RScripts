local getdata = ReplicatedStorage:WaitForChild("requests")
    :WaitForChild("miscellaneous")
    :WaitForChild("get_data")

local useItem = ReplicatedStorage:WaitForChild("requests")
    :WaitForChild("character")
    :WaitForChild("use_item")

local standValue = player
    :WaitForChild("PlayerData")
    :WaitForChild("SlotData")
    :WaitForChild("Stand")

local function tableFind(tbl, value)
    for _, v in pairs(tbl) do
        if v == value then return true end
    end
    return false
end

local function getStandInfo()
    local standCatalog = getdata:InvokeServer("stand")
    local skinCatalog  = getdata:InvokeServer("stand_skin")
    local traitCatalog = getdata:InvokeServer("trait")
    local standData    = HttpService:JSONDecode(standValue.Value)

    if not standData or not standData.Name then return nil end

    local traitRarity = traitCatalog[standData.Trait]
        and traitCatalog[standData.Trait].Rarity or "N/A"

    local skinRarity = "None"
    if standData.Skin then
        local skins = skinCatalog[standData.Name]
        skinRarity = (skins and skins[standData.Skin]) or "Common"
    end

    return {
        name        = standData.Name,
        trait       = standData.Trait,
        traitRarity = traitRarity,
        strength    = standData.Strength,
        speed       = standData.Speed,
        specialty   = standData.Specialty,
        skin        = standData.Skin or "None",
        skinRarity  = skinRarity,
    }
end

local function getSignature(info)
    return info.name .. "|" .. info.trait .. "|"
        .. tostring(info.strength) .. tostring(info.speed) .. tostring(info.specialty) .. "|"
        .. info.skin
end

-- ================================================================
-- CONDITIONS
-- ================================================================

local function checkConditions(info)

    -- Stand name pre-gate (hard filter, applies in both modes)
    if CONFIG.standNames and not tableFind(CONFIG.standNames, info.name) then
        return false, nil
    end

    -- Trait: rarity tier OR explicit name whitelist
    local function traitHit()
        if CONFIG.traitRarities and tableFind(CONFIG.traitRarities, info.traitRarity) then
            return true
        end
        if CONFIG.traitNames and tableFind(CONFIG.traitNames, info.trait) then
            return true
        end
        return false
    end

    -- Skin: rarity tier OR explicit name whitelist
    local function skinHit()
        if info.skin == "None" then return false end
        if CONFIG.skinRarities and tableFind(CONFIG.skinRarities, info.skinRarity) then
            return true
        end
        return false
    end

    -- Stats: exact slot order vs any-order (sorted distribution match)
    local function statHit()
        if not CONFIG.statCombos then return false, nil end

        local actualGrades = {
            gradeMap[info.strength],
            gradeMap[info.speed],
            gradeMap[info.specialty],
        }

        for _, combo in ipairs(CONFIG.statCombos) do
            local matched = false

            if CONFIG.statMatchMode == "any" then
                local sc = {combo[1], combo[2], combo[3]}
                local sa = {actualGrades[1], actualGrades[2], actualGrades[3]}
                table.sort(sc)
                table.sort(sa)
                matched = (sc[1]==sa[1] and sc[2]==sa[2] and sc[3]==sa[3])
            else -- "exact"
                matched = (gradeIndex[combo[1]] == info.strength
                       and gradeIndex[combo[2]] == info.speed
                       and gradeIndex[combo[3]] == info.specialty)
            end

            if matched then
                local label = actualGrades[1] .. actualGrades[2] .. actualGrades[3]
                return true, "Stats: " .. label .. " [" .. CONFIG.statMatchMode .. "]"
            end
        end
        return false, nil
    end

    -- Apply overall mode
    if CONFIG.mode == "ALL" then
        local reasons = {}

        if CONFIG.traitRarities or CONFIG.traitNames then
            if not traitHit() then return false, nil end
            table.insert(reasons, "Trait: " .. info.traitRarity .. " (" .. info.trait .. ")")
        end
        if CONFIG.skinRarities then
            if not skinHit() then return false, nil end
            table.insert(reasons, "Skin: " .. info.skinRarity .. " (" .. info.skin .. ")")
        end
        if CONFIG.statCombos then
            local ok, label = statHit()
            if not ok then return false, nil end
            table.insert(reasons, label)
        end

        if #reasons == 0 then return false, nil end
        return true, table.concat(reasons, " | ")

    else -- "ANY"
        if traitHit() then
            return true, "Trait: " .. info.traitRarity .. " (" .. info.trait .. ")"
        end
        if skinHit() then
            return true, "Skin: " .. info.skinRarity .. " (" .. info.skin .. ")"
        end
        local ok, label = statHit()
        if ok then return true, label end
        return false, nil
    end
end

-- ================================================================
-- FARM LOOP
-- ================================================================

local function farmLoop()
    local lastSig      = nil
    local lastFired    = 0
    local ARROW_CD     = 5
    local metCondition = false

    while _G.standFarm do
        local info = getStandInfo()

        if info then
            local sig = getSignature(info)

            if sig ~= lastSig then
                lastSig = sig

                print(string.format("[StandFarm] Stand: %s | Trait: %s (%s) | Stats: %s/%s/%s | Skin: %s (%s)",
                    info.name,
                    info.trait, info.traitRarity,
                    gradeMap[info.strength]  or "?",
                    gradeMap[info.speed]     or "?",
                    gradeMap[info.specialty] or "?",
                    info.skin, info.skinRarity
                ))

                showNotification(
                    string.format("%s\nTrait: %s (%s)\nStats: %s / %s / %s\nSkin: %s (%s)",
                        info.name,
                        info.trait, info.traitRarity,
                        gradeMap[info.strength]  or "?",
                        gradeMap[info.speed]     or "?",
                        gradeMap[info.specialty] or "?",
                        info.skin, info.skinRarity),
                    false
                )

                local hit, reason = checkConditions(info)
                if hit then
                    print("[StandFarm] CONDITION MET: " .. reason)
                    print("[StandFarm] Stopping.")
                    showNotification(
                        string.format("%s\nTrait: %s (%s)\nStats: %s / %s / %s\nSkin: %s (%s)",
                            info.name,
                            info.trait, info.traitRarity,
                            gradeMap[info.strength]  or "?",
                            gradeMap[info.speed]     or "?",
                            gradeMap[info.specialty] or "?",
                            info.skin, info.skinRarity),
                        true
                    )
                    _G.standFarm = false
                    metCondition = true
                    break
                end
            end

            local now = tick()
            if now - lastFired >= ARROW_CD then
                useItem:FireServer("Stand Arrow")
                lastFired = now
                print("[StandFarm] Used Stand Arrow.")
            end
        else
            print("[StandFarm] Could not read stand data, retrying...")
        end

        task.wait(2)
    end

    print("[StandFarm] Stopped.")
    if not metCondition then
        showNotification("Stand Farm stopped.", false)
    end
    metCondition = false
end

