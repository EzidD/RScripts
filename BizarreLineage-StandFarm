-- ================================================================
-- NOTIFICATION LOGIC
-- ================================================================

local FADE_IN  = 0.25
local FADE_OUT = 0.35
local AUTO_HIDE = 5

local currentFadeTask = nil
local isShowing = false

local function applyTween(transparency, bgTrans, strokeTrans, btnBgTrans, duration)
    local ti = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(notifFrame, ti, { BackgroundTransparency = bgTrans }):Play()
    TweenService:Create(uiStroke,   ti, { Transparency = strokeTrans }):Play()
    TweenService:Create(divider,    ti, { BackgroundTransparency = transparency > 0 and 1 or 0.55 }):Play()
    TweenService:Create(titleLabel, ti, { TextTransparency = transparency }):Play()
    TweenService:Create(msgLabel,   ti, { TextTransparency = transparency }):Play()
    TweenService:Create(closeBtn,   ti, { TextTransparency = transparency,
                                          BackgroundTransparency = btnBgTrans }):Play()
end

local function doHide()
    if currentFadeTask then task.cancel(currentFadeTask) currentFadeTask = nil end
    isShowing = false
    applyTween(1, 1, 1, 1, FADE_OUT)
end

local function showNotification(message, persistent)
    if currentFadeTask then task.cancel(currentFadeTask) currentFadeTask = nil end

    if isShowing then
        applyTween(1, 1, 1, 1, FADE_OUT / 2)
        task.wait(FADE_OUT / 2)
    end

    isShowing = true
    msgLabel.Text = message

    if persistent then
        titleLabel.TextColor3      = Color3.fromRGB(100, 190, 255)
        notifFrame.BackgroundColor3 = Color3.fromRGB(8, 18, 45)
        uiStroke.Color             = Color3.fromRGB(80, 160, 255)
        divider.BackgroundColor3   = Color3.fromRGB(80, 140, 255)
        closeBtn.TextColor3        = Color3.fromRGB(120, 180, 255)
    else
        titleLabel.TextColor3      = Color3.fromRGB(70, 150, 255)
        notifFrame.BackgroundColor3 = Color3.fromRGB(10, 16, 32)
        uiStroke.Color             = Color3.fromRGB(50, 110, 230)
        divider.BackgroundColor3   = Color3.fromRGB(50, 90, 180)
        closeBtn.TextColor3        = Color3.fromRGB(100, 150, 230)
    end

    applyTween(0, 0.18, 0, 0.55, FADE_IN)

    if not persistent then
        currentFadeTask = task.delay(AUTO_HIDE, function()
            currentFadeTask = nil
            doHide()
        end)
    end
end

