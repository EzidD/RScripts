UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P then
        _G.standFarm = not _G.standFarm
        if _G.standFarm then
            print("[StandFarm] Toggled ON.")
            showNotification("Stand Farm ON\nPress P to stop.", false)
            task.spawn(farmLoop)
        else
            print("[StandFarm] Toggled OFF.")
            showNotification("Stand Farm OFF.", false)
        end
    end
end)

