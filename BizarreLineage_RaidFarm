local function strContains(haystack, needle)
    local hLen = #haystack
    local nLen = #needle
    if nLen == 0 then return true end
    if hLen < nLen then return false end
    for i = 1, hLen - nLen + 1 do
        local match = true
        for j = 1, nLen do
            if haystack:sub(i+j-1, i+j-1):lower() ~= needle:sub(j,j):lower() then
                match = false
                break
            end
        end
        if match then return true end
    end
    return false
end

local function isValidTarget(model)
    if model.Name == "Server" then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character == model then return false end
    end
    if strContains(model.Name, "Hostage") then return false end
    local hum  = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart", true)
    return hum ~= nil and root ~= nil and hum.Health > 0
end

local function isListedNPC(modelName)
    for _, name in ipairs(npcToFarm) do
        if strContains(modelName, name) then return true end
    end
    return false
end

local function fightUntilDead(targetNPC, farmFlag)
    local lockedRoot = targetNPC:FindFirstChild("HumanoidRootPart")
        or targetNPC:FindFirstChildWhichIsA("BasePart", true)
    if not lockedRoot then return end

    print("[Farm] Locked onto: " .. targetNPC.Name)

    local platform = Instance.new("Part")
    platform.Size        = Vector3.new(10, 1, 10)
    platform.Anchored    = true
    platform.CanCollide  = true
    platform.Transparency = 1
    platform.CanTouch    = false
    platform.CastShadow  = false
    platform.Parent      = game.Workspace

    local rsConn = true
    task.spawn(function()
        while rsConn do
            task.wait()
            local char = LocalPlayer.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            local targetPos = lockedRoot.Position + Vector3.new(0, _G.farmDistance, 0)
            platform.CFrame = CFrame.new(targetPos + Vector3.new(0, -1, 0))
            if _G.farmDistance < 0 then
                hrp.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(90), 0, 0)
            else 
                hrp.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end
    end)

    while farmFlag() do
        local hum = targetNPC:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 or not targetNPC.Parent then break end
        useSkills()
        task.wait(0.1)
        clickM1()
        task.wait(0.1)
    end

    platform:Destroy()
    rsConn = false
    task.wait()
end

