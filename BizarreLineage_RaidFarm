local function buildPipsTable(pips)
    local t = {}
    if pips then
        for i, pip in ipairs(pips) do
            t[i] = pip
        end
    end
    return t
end

local function doSellPass()
    local inventoryValue = LocalPlayer
        :WaitForChild("PlayerData")
        :WaitForChild("SlotData")
        :WaitForChild("Inventory")

    local raw = inventoryValue.Value
    if raw == "" then return end

    local ok, items = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok then
        warn("[AutoSell] JSON parse failed: " .. tostring(items))
        return
    end

    local soldCount = 0
    for _, item in ipairs(items) do
        if item.ID and not item.Locked then
            local args = {
                [1] = {
                    [1] = {
                        ["ID"]         = item.ID,
                        ["Pips"]       = buildPipsTable(item.Pips),
                        ["Name"]       = item.Name,
                        ["duplicates"] = 1
                    }
                }
            }
            SellItem:FireServer(unpack(args))
            soldCount += 1
            print(string.format("[AutoSell] Sold '%s' (%s)", item.Name, item.ID))
            task.wait(0.2)
        end
    end

    if soldCount > 0 then
        print(string.format("[AutoSell] Pass done - sold %d item(s).", soldCount))
    end
end

